# Secret API key — use with /api/roboflow serverless proxy (recommended for production)
ROBOFLOW_API_KEY=your_roboflow_private_api_key

# Browser-safe publishable key (rf_...) — direct detect.roboflow.com from client
# Only used when ROBOFLOW_API_KEY is NOT set. Universe public models only.
# NEXT_PUBLIC_ROBOFLOW_PUBLISHABLE_KEY=rf_your_workspace_id

# Model IDs (Roboflow Universe hosted detect API)
# Primary bat+ball: Baseball, BaseballBat
# ROBOFLOW_MODEL_ID=mlb-sbfxd/baseball-and-baseball-bat/1
# Alt: Ball, Bat
# ROBOFLOW_ALT_MODEL_ID=baseball-v1/baseball-and-bat/2
# Optional pose keypoints
# ROBOFLOW_POSE_MODEL_ID=swingapi/baseball-pose-4y9w6/4
# ROBOFLOW_POSE_ENABLED=true

# Missed-Call Text-Back demo (optional — app works fully with seeded mocks)
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+15551234567
# TWILIO_OWNER_TEST_NUMBER=+15559876543
